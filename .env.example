# LinkPulse Environment Configuration
PORT=5000
NODE_ENV=development

# Database: In local development, use SQLite file or PostgreSQL.
# For SQLite (default zero-dependency local dev): file:./dev.db
# For PostgreSQL (production/Docker): postgresql://postgres:postgres@localhost:5432/linkpulse?schema=public
DATABASE_URL="file:./dev.db"

# Redis: Optional in local dev (falls back to resilient high-speed in-memory cache)
# For local Redis / production: redis://localhost:6379
REDIS_URL=

# Security & Authentication
JWT_SECRET=linkpulse_super_secret_jwt_key_change_in_production_2026!
JWT_EXPIRES_IN=7d
ANALYTICS_HASH_SECRET=linkpulse_privacy_salt_hash_secret_key_98765

# Application URLs
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Default Seed Admin Credentials
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@linkpulse.io
ADMIN_PASSWORD=AdminPassword2026!

# Optional IP Geolocation API Key (uses bundled offline geoip-lite if blank)
IP_GEOLOCATION_API_KEY=
